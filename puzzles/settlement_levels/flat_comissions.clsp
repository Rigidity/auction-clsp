; flat_comissions.clsp by yakuhito
; commissions affect the remaining bid amount
; flat comissions are static - Bid Amount doesn't matter

(mod (
    COMISSION_LIST ; (list (comission . recipient))
    INNER_LEVEL
    Bid_Amount
    Remaining_Bid_Amount
    inner_level_solution
)
    (include condition_codes.clib)
    
    (defun pay_comissions (INNER_LEVEL inner_level_solution Bid_Amount Remaining_Bid_Amount remaining_list)
        (if premium_list
            (c 
                (list CREATE_COIN (r (f remaining_list)) (f (f remaining_list)) (list (r (f remaining_list))))
                (pay_comissions
                    INNER_LEVEL inner_level_solution Bid_Amount
                    (- Remaining_Bid_Amount (f (f remaining_list)))
                    (r remaining_list)
                )
            )
            ; else
            (a INNER_LEVEL (list Bid_Amount Remaining_Bid_Amount inner_level_solution))
        )
    )

    (pay_comissions
        INNER_LEVEL inner_level_solution Bid_Amount Remaining_Bid_Amount COMISSION_LIST
    )
)