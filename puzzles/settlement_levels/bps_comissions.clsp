; comissions affect the remaining bid amount
(mod (
    COMISSION_LIST ; (list (bps . recipient))
    INNER_LEVEL
    Bid_Amount
    Remaining_Bid_Amount
    inner_level_solution
)
    (defun pay_comissions (INNER_LEVEL inner_level_solution Bid_Amount Remaining_Bid_Amount remaining_list)
        (if premium_list
            (c 
                (list CREATE_COIN (r (f remaining_list)) (/ (* (f (f remaining_list)) Bid_Amount) 10000) (list (r (f remaining_list))))
                (pay_comissions
                    INNER_LEVEL inner_level_solution Bid_Amount
                    (- Remaining_Bid_Amount (/ (* (f (f remaining_list)) Bid_Amount) 10000))
                    (r remaining_list)
                )
            )
            ; else
            (a INNER_LEVEL (list Bid_Amount Remaining_Bid_Amount inner_level_solution))
        )
    )

    (pay_premiums
        INNER_LEVEL inner_level_solution Bid_Amount Remaining_Bid_Amount COMISSION_LIST
    )
)