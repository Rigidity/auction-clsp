; sends remaining amount to auction starter
(mod (
    AUCTION_STARTER
    Bid_Amount
    Conditions_So_Far
    solution ; unused
)
    (include condition_codes.clib)

    (defun process_conditions (AUCTION_STARTER remaining_amount conds)
        (if conds 
            (c (f conds)
                (process_conditions
                    AUCTION_STARTER
                    (- remaining_amount (if (= (f (f conds)) CREATE_COIN) (f (r (r (f conds)))) 0))
                    (r conds)
                )
            )
            ; else
            (list
                (list CREATE_COIN AUCTION_STARTER remaining_amount (list AUCTION_STARTER))
            )
        )
    )

    (process_conditions AUCTION_STARTER Bid_Amount Conditions_So_Far)
)