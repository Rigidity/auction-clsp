(mod (
        TOP_LEVEL
        RESERVE_FULL_PUZZLE_HASH
        (King_Committed_Amount Auction_End King_Bid Current_King Bid_Index)
        reserve_parent_id
        top_level_solution
    )
    (include sha256tree.clib)

    (list 
        (list
            SEND_MESSAGE
            23 ; puzzle - coin
            (sha256tree (c 
                1 ; q . from (q . conditions)
                (a TOP_LEVEL (list King_Bid King_Bid top_level_solution)))
            ) ; delegated puzzle hash
            (coinid reserve_parent_id RESERVE_FULL_PUZZLE_HASH King_Committed_Amount) ; receiver coin id
        ) ; spend reserve
        (list ASSERT_SECONDS_ABSOLUTE Auction_End) ; make sure the auction ended
        (list CREATE_COIN Current_King 1 (list Current_King)) ; king gets singleton as well - as a memory
    )
)