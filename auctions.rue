struct State {
    ephemeral: EphemeralState | nil,
    ...persistent: PersistentState,
}

struct EphemeralState {}

struct PersistentState {
    reserve_amount: Int,
    winning_bid: Bid,
}

struct Output {
    state: State,
    ...conditions: List<ActionCondition>,
}

struct Bid {
    amount: Int,
    index: Int,
    puzzle_hash: Bytes32,
}

struct ReserveCondition {
    opcode = -41,
    ...condition: Condition,
}

type ActionCondition = Condition | ReserveCondition;

// These programs are used to make the behavior of auctions more modular,
// enabling configuration without needing to change the core logic of the auction.
// However, it's a balance between flexibility and complexity, so they are starting out simple.

type BidValidator = fn(previous_bid: Bid, new_bid: Bid, ...solution: Any) -> List<Condition>;
type BidPremiumCalculator = fn(bid: Bid) -> Int;
type SettlementValidator = fn(winning_bid: Bid, ...solution: Any) -> List<Condition>;

export fn default_bid_validator(
    expiration_seconds: Int,
    minimum_amount: Int,
    minimum_increase: Int,
    previous_bid: Bid,
    new_bid: Bid,
) -> List<Condition> {
    let increase = new_bid.amount - previous_bid.amount;
    assert new_bid.amount > minimum_amount - 1 && increase > minimum_increase - 1;
    [AssertBeforeSecondsAbsolute { seconds: expiration_seconds }]
}

export fn default_bid_premium_calculator(
    premium_basis_points: Int,
    bid: Bid,
) -> Int {
    bid.amount * premium_basis_points / 10000
}

export fn default_settlement_validator(
    expiration_seconds: Int,
    _winning_bid: Bid,
) -> List<Condition> {
    [AssertSecondsAbsolute { seconds: expiration_seconds }]
}

// The bid action allows anyone to place a new bid on the underlying.
// If the bid meets the requirements, it will replace and refund the previous bidder.
// This action cannot be run after the auction is over.

struct BidSolution {
    amount: Int,
    puzzle_hash: Bytes32,
    ...bid_solution: Any,
}

export fn bid_action(
    bid_validator: BidValidator,
    bid_premium_calculator: BidPremiumCalculator,
    state: State,
    solution: BidSolution,
) -> Output {
    inline let {
        reserve_amount: previous_reserve_amount,
        winning_bid: previous_bid
    } = state.persistent;

    let new_bid = Bid {
        amount: solution.amount,
        puzzle_hash: solution.puzzle_hash,
        index: previous_bid.index + 1,
    };

    let bid_conditions = bid_validator(previous_bid, new_bid, ...solution.bid_solution);

    let refund = ReserveCondition {
        condition: CreateCoin {
            puzzle_hash: previous_bid.puzzle_hash,
            amount: previous_reserve_amount,
            memos: Memos {
                value: [previous_bid.puzzle_hash],
            },
        },
    };

    Output {
        state: State {
            ephemeral: state.ephemeral,
            persistent: PersistentState {
                reserve_amount: new_bid.amount + bid_premium_calculator(new_bid),
                winning_bid: new_bid,
            },
        },
        conditions: [refund, ...bid_conditions],
    }
}

// The settle action can be run any time after the auction is over.
// The conditions for the auction ending are also enforced by the bid action,
// so it's not required to run this action in order to protect the underlying from other bidders.
// Essentially, whoever has the winning bid at the time of settlement will have custody of the underlying.

struct SettleSolution {
    ...settlement_solution: Any,
}

export fn settle_action(
    sale_puzzle_hash: Bytes32,
    premium_puzzle_hash: Bytes32,
    underlying_coin_id: Bytes32,
    settlement_validator: SettlementValidator,
    bid_premium_calculator: BidPremiumCalculator,
    state: State,
    solution: SettleSolution,
) -> Output {
    inline let { winning_bid } = state.persistent;

    let settlement_conditions = settlement_validator(winning_bid, ...solution.settlement_solution);
    let buyers_premium = bid_premium_calculator(winning_bid);

    let sale_payment = ReserveCondition {
        condition: CreateCoin {
            puzzle_hash: sale_puzzle_hash,
            amount: winning_bid.amount,
            memos: Memos {
                value: [sale_puzzle_hash],
            },
        },
    };

    let unlock = SendMessage {
        receiver: [underlying_coin_id],
        message: winning_bid.puzzle_hash,
        mode: 63,
    };

    let conditions = [unlock, sale_payment, ...settlement_conditions];
    
    let conditions = inline if buyers_premium > 0 {
        let premium_payment = ReserveCondition {
            condition: CreateCoin {
                puzzle_hash: premium_puzzle_hash,
                amount: buyers_premium,
                memos: Memos {
                    value: [premium_puzzle_hash],
                },
            },
        };
        [premium_payment, ...conditions]
    } else {
        conditions
    };
    
    Output { state, conditions }
}
